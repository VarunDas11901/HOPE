generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         Int      @id @default(autoincrement())
  gamerName  String
  email      String
  game       String
  skillLevel String
  region     String
  createdAt  DateTime @default(now())
}